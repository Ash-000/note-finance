# FinNote Configuration

# PostgreSQL Connection String
# Format: postgresql://username:password@localhost:5432/finnote
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finnote

# JWT Secret untuk Autentikasi User
JWT_SECRET=super-secret-jwt-key-change-in-production

# Telegram Bot Configuration
# Dapatkan token bot dari https://t.me/botfather dengan perintah /newbot
TELEGRAM_BOT_TOKEN=

# Port untuk REST API backend (default 3001)
PORT=3001

# URL FinNote (jika sudah di-deploy ke Vercel atau tunnel HTTPS seperti ngrok)
WEBAPP_URL=
