# FinNote Telegram Bot Configuration
# Dapatkan token bot dari https://t.me/botfather dengan perintah /newbot
TELEGRAM_BOT_TOKEN=

# Port untuk REST API backend lokal (default 3001)
PORT=3001

# URL FinNote (jika sudah di-deploy ke Vercel atau tunnel HTTPS seperti ngrok)
# Digunakan untuk tombol Telegram Mini App
WEBAPP_URL=
